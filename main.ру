import asyncio
import base64
import os

from openai import OpenAI
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, ReplyKeyboardMarkup, Update
from telegram.ext import (
    Application,
    CallbackQueryHandler,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

from storage import (
    add_pet,
    ensure_user,
    get_active_pet,
    init_db,
    list_pets,
    save_consultation,
    set_active_pet,
)

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

MENU = ReplyKeyboardMarkup(
    [
        ["🩺 Описать симптомы", "📄 Загрузить анализы"],
        ["💊 Разобрать назначения", "🐾 Мои питомцы"],
        ["➕ Добавить питомца", "👨‍⚕️ Записаться на консультацию"],
    ],
    resize_keyboard=True,
)

SPECIES_MENU = ReplyKeyboardMarkup(
    [["🐶 Собака", "🐱 Кошка"], ["❌ Отмена"]],
    resize_keyboard=True,
    one_time_keyboard=True,
)

SEX_MENU = ReplyKeyboardMarkup(
    [["Самец", "Самка"], ["❌ Отмена"]],
    resize_keyboard=True,
    one_time_keyboard=True,
)

SYSTEM_PROMPT = """
Ты — «МойДоктор», русскоязычный ветеринарный ИИ-помощник Ивана Труфанова.
Ты помогаешь владельцам собак и кошек разобраться в состоянии питомца.

Правила работы:
1. Используй уже известные данные активного питомца и не переспрашивай их без необходимости.
2. Собери недостающие клинические данные: жалобы, длительность симптомов, аппетит,
   воду, мочеиспускание, стул, температуру, хронические болезни, препараты и дозы.
3. Задавай не более 3 коротких вопросов за одно сообщение.
4. Не выдавай предположение за установленный диагноз. Разделяй возможные причины,
   что проверить и что делать сейчас.
5. При экстренных признаках начинай ответ словами:
   «🚨 Срочно обратитесь в ближайшую ветеринарную клинику».
6. Не советуй человеческие обезболивающие. Не назначай рецептурные препараты
   и не рассчитывай дозу без достаточных клинических данных.
7. При разборе анализов сверяй значение с референсным интервалом именно
   из документа. Не придумывай неразборчивые цифры. Укажи, что повышено,
   что понижено, возможное значение отклонений и следующие шаги.
8. Пиши по-русски обычным текстом, без Markdown, звёздочек и решёток.
9. Ответ должен быть компактным, обычно не более 1200 знаков.
"""

client = OpenAI(api_key=OPENAI_API_KEY) if OPENAI_API_KEY else None


def telegram_id(update: Update) -> int:
    return update.effective_user.id


def pet_summary(pet: dict | None) -> str:
    if not pet:
        return "Активный питомец не выбран."
    parts = [f"Имя: {pet['name']}", f"Вид: {pet['species']}"]
    if pet.get("breed"):
        parts.append(f"Порода: {pet['breed']}")
    if pet.get("age"):
        parts.append(f"Возраст: {pet['age']}")
    if pet.get("sex"):
        parts.append(f"Пол: {pet['sex']}")
    if pet.get("weight_kg") is not None:
        parts.append(f"Вес: {pet['weight_kg']:g} кг")
    return "; ".join(parts)


async def ensure_current_user(update: Update) -> None:
    user = update.effective_user
    await asyncio.to_thread(ensure_user, user.id, user.username, user.first_name)


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await ensure_current_user(update)
    active = await asyncio.to_thread(get_active_pet, telegram_id(update))
    active_text = (
        f"\n\nСейчас выбран питомец: {active['name']}."
        if active
        else "\n\nДобавьте питомца — тогда я буду помнить его данные между обращениями."
    )
    await update.message.reply_text(
        "🐾 Добро пожаловать в «МойДоктор»!\n\n"
        "Опишите проблему своими словами или выберите нужный раздел ниже."
        + active_text
        + "\n\nСообщения и медицинские файлы могут обрабатываться через OpenAI API, "
        "а карточка питомца и история обращений — сохраняться для работы сервиса. "
        "Не отправляйте лишние персональные данные владельца.",
        reply_markup=MENU,
    )


async def menu_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    await update.message.reply_text("Выберите нужный раздел 👇", reply_markup=MENU)


async def ask_ai(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_text = update.message.text
    history = context.user_data.setdefault("history", [])
    history.append({"role": "user", "content": user_text})
    history[:] = history[-12:]
    await update.message.chat.send_action("typing")

    pet = await asyncio.to_thread(get_active_pet, telegram_id(update))
    instructions = SYSTEM_PROMPT + "\n\nДанные активного питомца:\n" + pet_summary(pet)

    try:
        response = await asyncio.to_thread(
            client.responses.create,
            model="gpt-5.6-sol",
            instructions=instructions,
            input=history,
        )
        answer = response.output_text.strip()
        if not answer:
            answer = "Не удалось сформировать ответ. Пожалуйста, повторите сообщение."
        history.append({"role": "assistant", "content": answer})
        history[:] = history[-12:]
        await asyncio.to_thread(
            save_consultation,
            telegram_id(update),
            user_text,
            answer,
            "chat",
        )
    except Exception:
        answer = (
            "Сейчас не удалось выполнить анализ. Попробуйте ещё раз через несколько "
            "минут или выберите «👨‍⚕️ Записаться на консультацию»."
        )

    await update.message.reply_text(answer, reply_markup=MENU)


async def analyze_pending_file(update: Update, context: ContextTypes.DEFAULT_TYPE):
    pending = context.user_data.pop("pending_file", None)
    if not pending:
        await update.message.reply_text(
            "Сначала пришлите фотографию анализа или PDF-файл.",
            reply_markup=MENU,
        )
        return

    await update.message.reply_text("Анализирую файл…", reply_markup=MENU)
    await update.message.chat.send_action("typing")

    try:
        telegram_file = await context.bot.get_file(pending["file_id"])
        file_bytes = bytes(await telegram_file.download_as_bytearray())
        encoded = base64.b64encode(file_bytes).decode("ascii")
        mime_type = pending["mime_type"]
        caption = pending["caption"]

        if pending["input_type"] == "input_file":
            media_part = {
                "type": "input_file",
                "filename": pending["filename"],
                "file_data": f"data:{mime_type};base64,{encoded}",
                "detail": "high",
            }
        else:
            media_part = {
                "type": "input_image",
                "image_url": f"data:{mime_type};base64,{encoded}",
                "detail": "high",
            }

        pet = await asyncio.to_thread(get_active_pet, telegram_id(update))
        instructions = SYSTEM_PROMPT + "\n\nДанные активного питомца:\n" + pet_summary(pet)
        history = context.user_data.setdefault("history", [])
        response_input = history[-8:] + [
            {
                "role": "user",
                "content": [media_part, {"type": "input_text", "text": caption}],
            }
        ]

        response = await asyncio.to_thread(
            client.responses.create,
            model="gpt-5.6-sol",
            instructions=instructions,
            input=response_input,
        )
        answer = response.output_text.strip()
        if not answer:
            answer = "Не удалось прочитать документ. Пришлите более чёткое фото."

        history.append(
            {
                "role": "user",
                "content": f"Загружен документ {pending['filename']}. Запрос: {caption}",
            }
        )
        history.append({"role": "assistant", "content": answer})
        history[:] = history[-12:]
        await asyncio.to_thread(
            save_consultation,
            telegram_id(update),
            f"Файл: {pending['filename']}. {caption}",
            answer,
            "file_analysis",
        )
    except Exception:
        answer = (
            "Не удалось обработать файл. Проверьте, что это чёткое изображение "
            "или PDF не больше 10 МБ, и попробуйте снова."
        )

    await update.message.reply_text(answer, reply_markup=MENU)


async def show_pets(update: Update, context: ContextTypes.DEFAULT_TYPE):
    pets = await asyncio.to_thread(list_pets, telegram_id(update))
    active = await asyncio.to_thread(get_active_pet, telegram_id(update))
    if not pets:
        await update.message.reply_text(
            "У вас пока нет сохранённых питомцев. Нажмите «➕ Добавить питомца».",
            reply_markup=MENU,
        )
        return

    buttons = []
    lines = ["Ваши питомцы:"]
    for pet in pets:
        marker = "✅" if active and active["id"] == pet["id"] else "▫️"
        lines.append(f"{marker} {pet['name']} — {pet['species']}")
        buttons.append(
            [
                InlineKeyboardButton(
                    f"Выбрать: {pet['name']}",
                    callback_data=f"pet:{pet['id']}",
                )
            ]
        )

    await update.message.reply_text(
        "\n".join(lines) + "\n\nНажмите на питомца, с которым сейчас работаете.",
        reply_markup=InlineKeyboardMarkup(buttons),
    )


async def pet_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    try:
        pet_id = int(query.data.split(":", 1)[1])
    except (ValueError, AttributeError):
        return
    pet = await asyncio.to_thread(set_active_pet, update.effective_user.id, pet_id)
    if not pet:
        await query.edit_message_text("Не удалось выбрать питомца.")
        return
    await query.edit_message_text(
        f"✅ Активный питомец: {pet['name']}\n{pet_summary(pet)}"
    )


async def begin_add_pet(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data["pet_flow"] = {"step": "name", "data": {}}
    await update.message.reply_text(
        "Как зовут питомца?",
        reply_markup=ReplyKeyboardMarkup(
            [["❌ Отмена"]],
            resize_keyboard=True,
            one_time_keyboard=True,
        ),
    )


async def handle_pet_flow(update: Update, context: ContextTypes.DEFAULT_TYPE) -> bool:
    flow = context.user_data.get("pet_flow")
    if not flow:
        return False

    text = (update.message.text or "").strip()
    if text == "❌ Отмена":
        context.user_data.pop("pet_flow", None)
        await update.message.reply_text("Добавление питомца отменено.", reply_markup=MENU)
        return True

    step = flow["step"]
    data = flow["data"]

    if step == "name":
        data["name"] = text[:120]
        flow["step"] = "species"
        await update.message.reply_text("Это собака или кошка?", reply_markup=SPECIES_MENU)
    elif step == "species":
        species_map = {
            "🐶 собака": "собака",
            "🐱 кошка": "кошка",
            "собака": "собака",
            "кошка": "кошка",
        }
        species = species_map.get(text.lower())
        if not species:
            await update.message.reply_text(
                "Выберите «🐶 Собака» или «🐱 Кошка».",
                reply_markup=SPECIES_MENU,
            )
            return True
        data["species"] = species
        flow["step"] = "breed"
        await update.message.reply_text(
            "Порода? Если метис или порода неизвестна — напишите «нет».",
            reply_markup=ReplyKeyboardMarkup(
                [["Нет"], ["❌ Отмена"]],
                resize_keyboard=True,
                one_time_keyboard=True,
            ),
        )
    elif step == "breed":
        data["breed"] = None if text.lower() in {"нет", "не знаю", "-"} else text[:120]
        flow["step"] = "age"
        await update.message.reply_text(
            "Возраст питомца? Например: 8 лет или 7 месяцев.",
            reply_markup=ReplyKeyboardMarkup(
                [["❌ Отмена"]],
                resize_keyboard=True,
                one_time_keyboard=True,
            ),
        )
    elif step == "age":
        data["age"] = text[:80]
        flow["step"] = "sex"
        await update.message.reply_text("Пол питомца?", reply_markup=SEX_MENU)
    elif step == "sex":
        if text not in {"Самец", "Самка"}:
            await update.message.reply_text(
                "Выберите «Самец» или «Самка».",
                reply_markup=SEX_MENU,
            )
            return True
        data["sex"] = text.lower()
        flow["step"] = "weight"
        await update.message.reply_text(
            "Вес в килограммах? Например: 8.8. Если не знаете — напишите «нет».",
            reply_markup=ReplyKeyboardMarkup(
                [["Нет"], ["❌ Отмена"]],
                resize_keyboard=True,
                one_time_keyboard=True,
            ),
        )
    elif step == "weight":
        if text.lower() in {"нет", "не знаю", "-"}:
            data["weight_kg"] = None
        else:
            try:
                weight = float(text.replace(",", "."))
                if weight <= 0 or weight > 150:
                    raise ValueError
                data["weight_kg"] = weight
            except ValueError:
                await update.message.reply_text(
                    "Введите вес числом, например 8.8, либо напишите «нет».",
                    reply_markup=ReplyKeyboardMarkup(
                        [["Нет"], ["❌ Отмена"]],
                        resize_keyboard=True,
                        one_time_keyboard=True,
                    ),
                )
                return True

        pet = await asyncio.to_thread(
            add_pet,
            telegram_id(update),
            data["name"],
            data["species"],
            data.get("breed"),
            data.get("age"),
            data.get("sex"),
            data.get("weight_kg"),
        )
        context.user_data.pop("pet_flow", None)
        await update.message.reply_text(
            "✅ Питомец сохранён и выбран как активный.\n\n" + pet_summary(pet),
            reply_markup=MENU,
        )
    return True


async def message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    text = update.message.text

    if await handle_pet_flow(update, context):
        return

    if text == "🩺 Описать симптомы":
        active = await asyncio.to_thread(get_active_pet, telegram_id(update))
        intro = f"Сейчас выбран питомец: {active['name']}.\n" if active else ""
        await update.message.reply_text(
            intro
            + "Напишите:\n"
            "• что именно беспокоит;\n"
            "• когда появились симптомы;\n"
            "• аппетит, вода, стул и мочеиспускание;\n"
            "• какое лечение уже проводилось.",
            reply_markup=MENU,
        )
    elif text == "📄 Загрузить анализы":
        await update.message.reply_text(
            "Пришлите чёткую фотографию анализа или PDF. Можно добавить подпись с вопросом.",
            reply_markup=MENU,
        )
    elif text == "💊 Разобрать назначения":
        await update.message.reply_text(
            "Пришлите фото или PDF с назначениями либо напишите препараты и дозировки текстом.",
            reply_markup=MENU,
        )
    elif text == "🐾 Мои питомцы":
        await show_pets(update, context)
    elif text == "➕ Добавить питомца":
        await begin_add_pet(update, context)
    elif text == "👨‍⚕️ Записаться на консультацию":
        await update.message.reply_text(
            "Онлайн-консультации: понедельник, среда и пятница.\n\n"
            "Первичная — 3000 ₽ / $35.\n"
            "Повторная — 1500 ₽ / $20.\n\n"
            "Напишите удобный день и способ связи: видео, голосовые или чат.",
            reply_markup=MENU,
        )
    elif client is None:
        await update.message.reply_text("ИИ временно не подключён.", reply_markup=MENU)
    else:
        await ask_ai(update, context)


async def media(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)

    if client is None:
        await update.message.reply_text("ИИ временно не подключён.", reply_markup=MENU)
        return

    if update.message.photo:
        item = update.message.photo[-1]
        file_id = item.file_id
        file_size = item.file_size or 0
        mime_type = "image/jpeg"
        filename = "analysis.jpg"
        input_type = "input_image"
    elif update.message.document:
        document = update.message.document
        mime_type = document.mime_type or ""
        if mime_type not in {"application/pdf", "image/jpeg", "image/png", "image/webp"}:
            await update.message.reply_text(
                "Поддерживаются фотографии JPG/PNG/WEBP и PDF.",
                reply_markup=MENU,
            )
            return
        file_id = document.file_id
        file_size = document.file_size or 0
        filename = document.file_name or "document.pdf"
        input_type = "input_file" if mime_type == "application/pdf" else "input_image"
    else:
        return

    if file_size > 10 * 1024 * 1024:
        await update.message.reply_text(
            "Файл больше 10 МБ. Пришлите уменьшенную копию или отдельные страницы.",
            reply_markup=MENU,
        )
        return

    caption = update.message.caption or (
        "Разбери этот ветеринарный анализ или медицинский документ. "
        "Перечисли отклонения, объясни их значение и укажи следующие шаги."
    )
    context.user_data["pending_file"] = {
        "file_id": file_id,
        "mime_type": mime_type,
        "filename": filename,
        "input_type": input_type,
        "caption": caption,
    }

    await analyze_pending_file(update, context)


def main():
    if not TOKEN:
        raise RuntimeError("TELEGRAM_BOT_TOKEN is not set")

    init_db()
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("menu", menu_command))
    app.add_handler(CallbackQueryHandler(pet_callback, pattern=r"^pet:\d+$"))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, message))
    app.add_handler(MessageHandler(filters.PHOTO | filters.Document.ALL, media))
    app.run_polling()


if __name__ == "__main__":
    main()
