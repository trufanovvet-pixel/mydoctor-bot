import asyncio
import base64
import os

from openai import OpenAI
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, ReplyKeyboardMarkup, Update
from telegram.ext import (
    Application,
    CallbackQueryHandler,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

from storage import (
    add_pet,
    ensure_user,
    get_active_pet,
    init_db,
    list_pets,
    save_consultation,
    set_active_pet,
)

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

MENU = ReplyKeyboardMarkup(
    [
        ["🩺 Описать симптомы", "📄 Загрузить анализы"],
        ["💊 Разобрать назначения", "🐾 Мои питомцы"],
        ["➕ Добавить питомца", "👨‍⚕️ Записаться на консультацию"],
    ],
    resize_keyboard=True,
)

SPECIES_MENU = ReplyKeyboardMarkup(
    [["🐶 Собака", "🐱 Кошка"], ["❌ Отмена"]],
    resize_keyboard=True,
    one_time_keyboard=True,
)

SEX_MENU = ReplyKeyboardMarkup(
    [["Самец", "Самка"], ["❌ Отмена"]],
    resize_keyboard=True,
    one_time_keyboard=True,
)

SYSTEM_PROMPT = """
Ты — «МойДоктор», русскоязычный ветеринарный ИИ-помощник Ивана Труфанова.
Ты помогаешь владельцам собак и кошек разобраться в состоянии питомца.

Правила работы:
1. Используй уже известные данные активного питомца и не переспрашивай их без необходимости.
2. Собери недостающие клинические данные: жалобы, длительность симптомов, аппетит,
   воду, мочеиспускание, стул, температуру, хронические болезни, препараты и дозы.
3. Задавай не более 3 коротких вопросов за одно сообщение.
4. Не выдавай предположение за установленный диагноз. Разделяй возможные причины,
   что проверить и что делать сейчас.
5. При экстренных признаках начинай ответ словами:
   «🚨 Срочно обратитесь в ближайшую ветеринарную клинику».
6. Не советуй человеческие обезболивающие. Не назначай рецептурные препараты
   и не рассчитывай дозу без достаточных клинических данных.
7. При разборе анализов сверяй значение с референсным интервалом именно
   из документа. Не придумывай неразборчивые цифры. Укажи, что повышено,
   что понижено, возможное значение отклонений и следующие шаги.
8. Пиши по-русски обычным текстом, без Markdown, звёздочек и решёток.
9. Ответ должен быть компактным, обычно не более 1200 знаков.
10. Если используешь веб-источники, научные статьи, клинические рекомендации или справочники,
    не вставляй URL и ссылки внутрь основного медицинского текста и не ставь ссылку после каждого утверждения.
    Сначала дай чистый читаемый ответ. В самом конце добавь отдельный компактный блок «Источники:»
    максимум из 2–4 наиболее важных источников: короткое название источника/документа и ссылка.
    Не дублируй один и тот же источник. Для поиска клиник, адресов и навигации это правило не действует:
    там ссылки оставляй рядом с конкретной клиникой/местом, потому что они нужны для перехода.
"""

client = OpenAI(api_key=OPENAI_API_KEY) if OPENAI_API_KEY else None


def telegram_id(update: Update) -> int:
    return update.effective_user.id


def pet_summary(pet: dict | None) -> str:
    if not pet:
        return "Активный питомец не выбран."
    parts = [f"Имя: {pet['name']}", f"Вид: {pet['species']}"]
    if pet.get("breed"):
        parts.append(f"Порода: {pet['breed']}")
    if pet.get("age"):
        parts.append(f"Возраст: {pet['age']}")
    if pet.get("sex"):
        parts.append(f"Пол: {pet['sex']}")
    if pet.get("weight_kg") is not None:
        parts.append(f"Вес: {pet['weight_kg']:g} кг")
    return "; ".join(parts)


async def ensure_current_user(update: Update) -> None:
    user = update.effective_user
    await asyncio.to_thread(ensure_user, user.id, user.username, user.first_name)


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data.clear()
    await ensure_current_user(update)
    active = await asyncio.to_thread(get_active_pet, telegram_id(update))
    active_text = (
        f"\n\nСейчас выбран питомец: {active['name']}."
        if active
        else "\n\nДобавьте питомца — тогда я буду помнить его данные между обращениями."
    )
    await update.message.reply_text(
        "🐾 Добро пожаловать в «МойДоктор»!\n\n"
        "Опишите проблему своими словами или выберите нужный раздел ниже."
        + active_text
        + "\n\nСообщения и медицинские файлы могут обрабатываться через OpenAI API, "
        "а карточка питомца и история обращений — сохраняться для работы сервиса. "
        "Не отправляйте лишние персональные данные владельца.",
        reply_markup=MENU,
    )


async def menu_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    await update.message.reply_text("Главное меню", reply_markup=MENU)


async def ask_ai(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if client is None:
        await update.message.reply_text("ИИ временно не подключён.", reply_markup=MENU)
        return

    text = (update.message.text or "").strip()
    active = await asyncio.to_thread(get_active_pet, telegram_id(update))
    history = context.user_data.setdefault("history", [])
    history.append({"role": "user", "content": text})
    history[:] = history[-10:]

    instructions = SYSTEM_PROMPT + "\n\nДанные активного питомца:\n" + pet_summary(active)
    response = await asyncio.to_thread(
        client.responses.create,
        model="gpt-5.6-sol",
        instructions=instructions,
        input=history,
    )
    answer = response.output_text.strip()
    history.append({"role": "assistant", "content": answer})
    history[:] = history[-10:]
    await asyncio.to_thread(save_consultation, telegram_id(update), text, answer, "text")
    await update.message.reply_text(answer, reply_markup=MENU)


async def message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    text = (update.message.text or "").strip()

    if text == "🐾 Мои питомцы":
        pets = await asyncio.to_thread(list_pets, telegram_id(update))
        if not pets:
            await update.message.reply_text("Питомцев пока нет. Нажмите «➕ Добавить питомца».", reply_markup=MENU)
            return
        buttons = [[InlineKeyboardButton(f"{p['name']} — {p['species']}", callback_data=f"pet:{p['id']}")] for p in pets]
        await update.message.reply_text("Выберите питомца:", reply_markup=InlineKeyboardMarkup(buttons))
        return

    if text == "➕ Добавить питомца":
        context.user_data["adding_pet"] = {"step": "name"}
        await update.message.reply_text("Как зовут питомца?", reply_markup=ReplyKeyboardMarkup([["❌ Отмена"]], resize_keyboard=True))
        return

    if text == "👨‍⚕️ Записаться на консультацию":
        await update.message.reply_text(
            "Для записи на консультацию напишите администратору. Здесь позже добавим кнопку записи и оплату.",
            reply_markup=MENU,
        )
        return

    if text == "📄 Загрузить анализы":
        context.user_data["awaiting_file"] = True
        await update.message.reply_text("Пришлите фото, скриншот или PDF анализа/документа.", reply_markup=MENU)
        return

    adding = context.user_data.get("adding_pet")
    if adding:
        if text == "❌ Отмена":
            context.user_data.pop("adding_pet", None)
            await update.message.reply_text("Добавление отменено.", reply_markup=MENU)
            return
        step = adding.get("step")
        if step == "name":
            adding["name"] = text
            adding["step"] = "species"
            await update.message.reply_text("Кто это?", reply_markup=SPECIES_MENU)
            return
        if step == "species":
            if text not in {"🐶 Собака", "🐱 Кошка"}:
                await update.message.reply_text("Выберите вид кнопкой ниже.", reply_markup=SPECIES_MENU)
                return
            adding["species"] = "собака" if "Собака" in text else "кошка"
            adding["step"] = "breed"
            await update.message.reply_text("Порода? Если метис — так и напишите.")
            return
        if step == "breed":
            adding["breed"] = text
            adding["step"] = "age"
            await update.message.reply_text("Возраст? Например: 5 лет или 8 месяцев.")
            return
        if step == "age":
            adding["age"] = text
            adding["step"] = "sex"
            await update.message.reply_text("Пол?", reply_markup=SEX_MENU)
            return
        if step == "sex":
            if text not in {"Самец", "Самка"}:
                await update.message.reply_text("Выберите пол кнопкой ниже.", reply_markup=SEX_MENU)
                return
            adding["sex"] = text.lower()
            adding["step"] = "weight"
            await update.message.reply_text("Вес в кг? Например: 8.8")
            return
        if step == "weight":
            try:
                weight = float(text.replace(",", "."))
            except ValueError:
                await update.message.reply_text("Напишите вес числом, например 8.8")
                return
            pet_id = await asyncio.to_thread(
                add_pet,
                telegram_id(update),
                adding["name"],
                adding["species"],
                adding.get("breed"),
                adding.get("age"),
                adding.get("sex"),
                weight,
            )
            await asyncio.to_thread(set_active_pet, telegram_id(update), pet_id)
            name = adding["name"]
            context.user_data.pop("adding_pet", None)
            await update.message.reply_text(f"Готово. {name} добавлен и выбран активным питомцем.", reply_markup=MENU)
            return

    await ask_ai(update, context)


async def pet_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    pet_id = int(query.data.split(":", 1)[1])
    await asyncio.to_thread(set_active_pet, telegram_id(update), pet_id)
    pets = await asyncio.to_thread(list_pets, telegram_id(update))
    pet = next((p for p in pets if p["id"] == pet_id), None)
    await query.edit_message_text(f"Выбран питомец: {pet['name']}" if pet else "Питомец выбран.")


async def media(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    if client is None:
        await update.message.reply_text("ИИ временно не подключён.", reply_markup=MENU)
        return

    if update.message.photo:
        item = update.message.photo[-1]
        file_id = item.file_id
        mime_type = "image/jpeg"
        filename = "analysis.jpg"
        input_type = "input_image"
    elif update.message.document:
        item = update.message.document
        file_id = item.file_id
        mime_type = item.mime_type or "application/octet-stream"
        filename = item.file_name or "document"
        input_type = "input_file"
    else:
        return

    await update.message.reply_text("Читаю документ…")
    tg_file = await context.bot.get_file(file_id)
    data = bytes(await tg_file.download_as_bytearray())
    encoded = base64.b64encode(data).decode("ascii")
    active = await asyncio.to_thread(get_active_pet, telegram_id(update))
    instructions = SYSTEM_PROMPT + "\n\nДанные активного питомца:\n" + pet_summary(active)

    if input_type == "input_image":
        content = [
            {"type": "input_image", "image_url": f"data:{mime_type};base64,{encoded}", "detail": "high"},
            {"type": "input_text", "text": "Прочитай анализ или медицинский документ на изображении и объясни отклонения."},
        ]
    else:
        content = [
            {"type": "input_file", "filename": filename, "file_data": f"data:{mime_type};base64,{encoded}"},
            {"type": "input_text", "text": "Прочитай медицинский документ и объясни основные результаты."},
        ]

    response = await asyncio.to_thread(
        client.responses.create,
        model="gpt-5.6-sol",
        instructions=instructions,
        input=[{"role": "user", "content": content}],
    )
    answer = response.output_text.strip()
    await asyncio.to_thread(save_consultation, telegram_id(update), f"Файл: {filename}", answer, "file_analysis")
    await update.message.reply_text(answer, reply_markup=MENU)


async def voice_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await ensure_current_user(update)
    await update.message.reply_text("Голосовые сообщения пока не подключены. Напишите вопрос текстом.", reply_markup=MENU)


async def run() -> None:
    await asyncio.to_thread(init_db)
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("menu", menu_command))
    app.add_handler(CallbackQueryHandler(pet_callback, pattern=r"^pet:\\d+$"))
    app.add_handler(MessageHandler(filters.PHOTO | filters.Document.ALL, media))
    app.add_handler(MessageHandler(filters.VOICE, voice_message))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, message))
    await app.initialize()
    await app.start()
    await app.updater.start_polling()
    try:
        while True:
            await asyncio.sleep(3600)
    finally:
        await app.updater.stop()
        await app.stop()
        await app.shutdown()
